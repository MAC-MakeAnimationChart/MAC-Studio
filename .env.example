# Public settings (safe in the browser). Copy to .env.local and fill in.

# Backend origin, e.g. https://api.example.com. Leave empty while there is no backend:
# the screens then use a built-in mock (and a fake social login page).
NEXT_PUBLIC_API_BASE=

# Social login client IDs (public). Leave empty to use the fake login page.
# Register this callback address in each provider console:
#   <site origin>/auth/callback/google | /kakao | /naver
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=

# Client secrets are NOT set here. They belong to the backend only.
