# Public settings (safe in the browser). Copy to .env.local and fill in.

# Mock switch. true (or unset) = built-in mock, no server needed (and a fake social login page).
# false = talk to the real backend at NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_IS_MOCK=true

# Backend origin only, no path: e.g. http://localhost:8080 (the code adds /api/v1).
# The backend must list this site's origin in its CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE=

# Version of the terms / privacy documents users agree to; must match the backend's required version.
# TEMPORARY default v1 until the legal documents are final.
NEXT_PUBLIC_TERMS_VERSION=v1

# Social login client IDs (public). Leave empty to use the fake login page.
# Register this callback address in each provider console:
#   <site origin>/auth/callback/google | /kakao | /naver
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=

# Client secrets are NOT set here. They belong to the backend only.

# --- Search engines (see docs/SEO.md) ---
# The real address of the site, no trailing slash. Used for canonical links, the sitemap and share
# previews. Set it as soon as the domain exists; until then Vercel's own address is used.
NEXT_PUBLIC_SITE_URL=

# Site ownership codes: the content="..." value of the HTML tag that Google Search Console and
# Naver Search Advisor give you. Leave empty to add no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = Google Analytics is not loaded.
# Update the privacy policy (app/privacy/page.tsx) before turning this on.
NEXT_PUBLIC_GA_ID=
